<Window x:Class="VectorTrussCanvas.BridgeSketcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track B.2: Bridge Blueprint Sketcher" 
        Height="720" Width="980"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bridge Blueprint Sketcher" 
                           FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkGridSnap" Content="0.5m Raster-Snapping" IsChecked="True" 
                          Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="JSON Export" Click="BtnExport_Click" Margin="20,0,0,0" Padding="10,4"/>
                <Button Content="Alles löschen" Click="BtnClear_Click" Margin="8,0,0,0" Padding="10,4"/>
            </StackPanel>
        </Border>

        <!-- Main Canvas Area mit eingebetteter Legenden-Box -->
        <Border Grid.Row="1" Background="#141414" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Zeichenfläche -->
                <Canvas x:Name="SketchCanvas" 
                        Background="Transparent"
                        SizeChanged="SketchCanvas_SizeChanged"
                        MouseDown="SketchCanvas_MouseDown"
                        MouseMove="SketchCanvas_MouseMove"
                        MouseUp="SketchCanvas_MouseUp"/>

                <!-- Dauerhafte Steuerung-Legende (Oben links auf dem Canvas) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="12" Padding="10" 
                        Background="#CC1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" 
                        CornerRadius="4" IsHitTestVisible="False">
                    <StackPanel Width="220">
                        <TextBlock Text="⌨ Steuerung &amp; Aktionen" FontWeight="Bold" Foreground="#00D2FF" FontSize="12" Margin="0,0,0,6"/>

                        <Grid Margin="0,2">
                            <TextBlock Text="Linksklick ins Leere:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Knoten setzen" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Linksklick auf Knoten:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Verschieben" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Shift + Klick:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Stab verbinden" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Alt + Klick:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Mehrfachauswahl" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Ctrl + Klick:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Last (25 kN)" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Rechtsklick:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Lager umschalten" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Entf (Delete):" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="Auswahl/Knoten löschen" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtSketchInfo" Text="Bereit für Eingaben." 
                       Foreground="#9CDCFE" FontSize="12" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>