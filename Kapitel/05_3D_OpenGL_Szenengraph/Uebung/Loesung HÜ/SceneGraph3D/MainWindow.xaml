<Window x:Class="SceneGraph3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sharpGL="clr-namespace:SharpGL.WPF;assembly=SharpGL.WPF"
        Title="Termin 05: 3D-Computergrafik, SharpGL &amp; Hierarchischer Szenengraph" 
        Height="760" Width="1200"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="3D-Visualisierung, Orbit-Kamera &amp; Vorwärtskinematik-Szenengraph" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Systemsimulation / Digitaler Zwilling - Fachhochschule Oberösterreich (Campus Wels)" 
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Modus:" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ModeCombo" Width="270" SelectedIndex="0" Margin="0,0,14,0" VerticalContentAlignment="Center"
                              SelectionChanged="ModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Stufe 1 – SCARA-Basisaufgabe"/>
                        <ComboBoxItem Content="Stufe 2 – Track B: Arcade Claw Crane"/>
                    </ComboBox>
                    <Button x:Name="BtnResetView" Content="Kamera zurücksetzen" Click="BtnResetView_Click" Margin="0,0,8,0" Padding="12,5"/>
                    <Button x:Name="BtnResetJoints" Content="Gelenke nullen" Click="BtnResetJoints_Click" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Viewport and Controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 3D OpenGL Viewport -->
            <Border Grid.Column="0" Background="#0A0A0A" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                <sharpGL:OpenGLControl x:Name="OpenGlView" 
                                       OpenGLDraw="OpenGlView_OpenGLDraw" 
                                       OpenGLInitialized="OpenGlView_OpenGLInitialized" 
                                       Resized="OpenGlView_Resized"
                                       MouseDown="OpenGlView_MouseDown"
                                       MouseMove="OpenGlView_MouseMove"
                                       MouseUp="OpenGlView_MouseUp"
                                       MouseWheel="OpenGlView_MouseWheel"/>
            </Border>

            <!-- Controls Sidebar -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="14" BorderBrush="#3F3F46" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ================= Stufe 1: SCARA ================= -->
                        <StackPanel x:Name="PanelStage1">
                            <TextBlock Text="Gelenksteuerung (SCARA)" FontWeight="Bold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,12"/>

                            <!-- Joint 1 -->
                            <TextBlock Text="Gelenk 1 - Schulter theta1 [°]:" Foreground="#D4D4D4" Margin="0,2,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderTheta1" Minimum="-150" Maximum="150" Value="30" ValueChanged="SliderJoint_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtTheta1" Text="30°" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <!-- Joint 2 -->
                            <TextBlock Text="Gelenk 2 - Ellenbogen theta2 [°]:" Foreground="#D4D4D4" Margin="0,8,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderTheta2" Minimum="-150" Maximum="150" Value="-45" ValueChanged="SliderJoint_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtTheta2" Text="-45°" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <!-- Joint 3 (Pinole Hub) -->
                            <TextBlock Text="Gelenk 3 - Vertikalhub d3 [m]:" Foreground="#D4D4D4" Margin="0,8,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderD3" Minimum="0.0" Maximum="0.5" Value="0.15" SmallChange="0.01" ValueChanged="SliderJoint_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtD3" Text="0.15 m" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                            <!-- Tool Center Point (TCP) Telemetrie -->
                            <TextBlock Text="Tool Center Point (TCP):" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,6"/>
                            <Border Background="#1B2B3A" CornerRadius="3" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Analytische Vorwärtskinematik:" Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtTcpAnalytic" Text="X = 1.45 m | Y = 0.35 m | Z = -0.28 m" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" Margin="0,2,0,6"/>
                                
                                    <TextBlock Text="Szenengraph-Matrix (OpenGL):" Foreground="#9CDCFE" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtTcpMatrix" Text="X = 1.45 m | Y = 0.35 m | Z = -0.28 m" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" Margin="0,2,0,4"/>

                                    <TextBlock x:Name="TxtTcpDiff" Text="Deckungsfehler Delta = 0.000 mm" Foreground="#98FB98" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= Stufe 2: Claw Crane (Track B) ================= -->
                        <StackPanel x:Name="PanelStage2" Visibility="Collapsed">
                            <TextBlock Text="Claw Crane – Achsen" FontWeight="Bold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,12"/>

                            <TextBlock Text="X-Brücke – Position X [m]:" Foreground="#D4D4D4" Margin="0,2,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderCraneX" Minimum="-1.5" Maximum="1.5" Value="0" ValueChanged="CraneSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCraneX" Text="0.00 m" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Laufkatze – Position Z [m]:" Foreground="#D4D4D4" Margin="0,8,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderCraneZ" Minimum="-1.0" Maximum="1.0" Value="0" ValueChanged="CraneSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCraneZ" Text="0.00 m" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Seilzug – Höhe Greifer-Zentrum Y [m]:" Foreground="#D4D4D4" Margin="0,8,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderCraneY" Minimum="0.2" Maximum="2.0" Value="2.0" ValueChanged="CraneSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCraneY" Text="2.00 m" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Klaue – Fingerwinkel gamma [°] (0 = zu, 45 = offen):" Foreground="#D4D4D4" Margin="0,8,0,2" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SliderCraneGamma" Minimum="0" Maximum="45" Value="45" ValueChanged="CraneSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCraneGamma" Text="45°" Foreground="#9CDCFE" TextAlignment="Right"/>
                            </Grid>

                            <Button x:Name="BtnStartCycle" Content="▶  Greifzyklus starten (Leertaste)" Click="BtnStartCycle_Click" Margin="0,14,0,0" Padding="10,6"/>
                            <CheckBox x:Name="ChkSpotlight" Content="Spotlight (GL_LIGHT1) an der Decke" IsChecked="True" Foreground="#D4D4D4"
                                      Margin="0,10,0,0" Checked="ChkSpotlight_Changed" Unchecked="ChkSpotlight_Changed"/>

                            <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                            <TextBlock Text="Spielstatus:" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,6"/>
                            <Border Background="#1B2B3A" CornerRadius="3" Padding="8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCranePhase" Text="Phase: Bereit" Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtCraneCenter" Text="Greifer-Zentrum: -" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtCraneNearest" Text="Nächster Preis: -" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtCraneScore" Text="Im Schacht: 0 / 10" Foreground="#98FB98" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tastatur:" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,14,0,4"/>
                            <TextBlock Text="• Pfeiltasten: Laufkatze fahren (← → = X, ↑ ↓ = Z)" Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="• Leertaste: Greifzyklus (absenken → schließen → hochfahren → zum Schacht → öffnen)" Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="• Greifradius r_grab = 0,30 m (3D-Abstand Greifer-Zentrum ↔ Preis)" Foreground="#CE9178" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>

                        <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                        <!-- Camera Guide -->
                        <TextBlock Text="Kamerasteuerung (Orbit):" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,0,0,4"/>
                        <TextBlock Text="• Linke Maustaste + Bewegen: Orbit-Rotation (Azimut &amp; Elevation)" Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="• Rechte Maustaste + Bewegen: Panning (Zielpunkt verschieben)" Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="• Mausrad: Zoom (Distanz verändern)" Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="• Elevation ist kardanfehlerfrei auf [-85°, +85°] beschränkt." Foreground="#CE9178" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="OpenGL bereit. Phong-Beleuchtung GL_LIGHT0 aktiv." 
                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="SharpGL 3.1 | Kaskadierter Matrix-Stack | Kardanfehlerfrei" 
                           Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
