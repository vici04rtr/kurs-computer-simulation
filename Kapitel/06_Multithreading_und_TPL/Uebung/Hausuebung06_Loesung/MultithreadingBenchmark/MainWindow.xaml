<Window x:Class="MultithreadingBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termin 06: Multithreading, TPL &amp; Reaktive WPF-Entkopplung (Amdahl-Dashboard)"
        Height="800" Width="1260"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="Parallele Partikelsimulation"
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubHeader"
                               Text="Systemsimulation / Digitaler Zwilling – FH Oberösterreich (Campus Wels)"
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Modus:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- Foreground bewusst dunkel: Das Standard-Template des ComboBox hat einen hellen Hintergrund -->
                    <ComboBox x:Name="CmbStage" Width="285" SelectedIndex="0" Foreground="#1E1E1E" Padding="8,5" Margin="0,0,12,0"
                              ToolTip="Zwischen Stufe 1 (Basisaufgabe) und Stufe 2 (Track B) umschalten. Nur im Leerlauf möglich."
                              SelectionChanged="CmbStage_SelectionChanged">
                        <ComboBoxItem Content="Stufe 1 – Partikel-Dashboard (Basis)"/>
                        <ComboBoxItem Content="Stufe 2 – Track B: Schwarm &amp; Zombie-Horde"/>
                    </ComboBox>
                    <Button x:Name="BtnResetParticles" Content="Partikel zurücksetzen" Click="BtnResetParticles_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRunScaling" Content="Amdahl-Skalierungsreihe (1..P Kerne)" Click="BtnRunScaling_Click" Padding="12,6" FontWeight="SemiBold" Background="#0E639C" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- Left: WriteableBitmap 2D Viewport (gemeinsam für Stufe 1 und Stufe 2) -->
            <Border Grid.Column="0" Background="#0E1117" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Image x:Name="ParticleImage" Stretch="Fill" MouseDown="ParticleImage_MouseDown" MouseMove="ParticleImage_MouseMove" Cursor="Cross"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC1E1E1E" CornerRadius="4" Padding="8,5" Margin="10">
                        <TextBlock x:Name="TxtViewportHint"
                                   Text="Linksklick ins Bild: Gravitations-Attraktor (rotes Fadenkreuz) verschieben"
                                   FontSize="11" Foreground="#CCCCCC"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Controls, Telemetry & Amdahl Table -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="14" BorderBrush="#3F3F46" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ===================== STUFE 1 ===================== -->
                        <StackPanel x:Name="PanelStage1">
                            <TextBlock Text="1. Simulations- &amp; Thread-Steuerung" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkUseParallel" Content="TPL Parallel.For aktivieren (sonst sequentielle for-Schleife)"
                                      IsChecked="True" Foreground="#E0E0E0" Margin="0,0,0,10"
                                      Checked="ChkUseParallel_Changed" Unchecked="ChkUseParallel_Changed"/>

                            <TextBlock Text="MaxDegreeOfParallelism (Thread-Anzahl p):" Foreground="#CCCCCC"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderThreads" Minimum="1" Maximum="16" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderThreads_ValueChanged"/>
                                <TextBlock x:Name="TxtThreads" Grid.Column="1" Text="8" Foreground="#4FC3F7" FontWeight="Bold" TextAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStart" Grid.Column="0" Content="▶ Simulation starten (200 Schritte)"
                                        Click="BtnStart_Click" Padding="8,8" Margin="0,0,4,0" FontWeight="Bold" Background="#2E7D32" Foreground="White"/>
                                <Button x:Name="BtnCancel" Grid.Column="1" Content="⏹ Not-Aus (Cancel)"
                                        Click="BtnCancel_Click" Padding="8,8" Margin="4,0,0,0" FontWeight="Bold" Background="#C62828" Foreground="White" IsEnabled="False"/>
                            </Grid>

                            <TextBlock Text="Simulationsfortschritt (IProgress&lt;T&gt;):" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                            <ProgressBar x:Name="SimProgressBar" Minimum="0" Maximum="100" Height="16" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="2. Live-Telemetrie &amp; Speedup" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <Border Background="#1B2631" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStepTime" Text="Mittlere Schrittzeit: -- ms/step" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtFps" Text="Simulations-Durchsatz: -- Steps/s (FPS)" FontFamily="Consolas" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSpeedup" Text="Gemessener Speedup S(p): -- x" FontFamily="Consolas" Foreground="#81C784" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtAmdahlS" Text="Serieller Anteil s (Amdahl): -- %" FontFamily="Consolas" Foreground="#FFB74D"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== STUFE 2 / TRACK B ===================== -->
                        <StackPanel x:Name="PanelStage2" Visibility="Collapsed">
                            <TextBlock Text="1. Schwarm-Steuerung (Track B, live)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                            <TextBlock Text="Agentenanzahl N (nur im Leerlauf änderbar):" Foreground="#CCCCCC"/>
                            <ComboBox x:Name="CmbAgentCount" SelectedIndex="2" Foreground="#1E1E1E" Margin="0,4,0,10" Padding="6,4"
                                      SelectionChanged="CmbAgentCount_SelectionChanged">
                                <ComboBoxItem Content="50.000 Agenten" Tag="50000"/>
                                <ComboBoxItem Content="75.000 Agenten" Tag="75000"/>
                                <ComboBoxItem Content="100.000 Agenten" Tag="100000"/>
                            </ComboBox>

                            <CheckBox x:Name="ChkSwarmParallel" Content="TPL Parallel.For (live umschaltbar; aus = sequentiell, 1 Thread)"
                                      IsChecked="True" Foreground="#E0E0E0" Margin="0,0,0,10"
                                      Checked="ChkSwarmParallel_Changed" Unchecked="ChkSwarmParallel_Changed"/>

                            <TextBlock Text="MaxDegreeOfParallelism (Thread-Anzahl p, live):" Foreground="#CCCCCC"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderSwarmThreads" Minimum="1" Maximum="16" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderSwarmThreads_ValueChanged"/>
                                <TextBlock x:Name="TxtSwarmThreads" Grid.Column="1" Text="8" Foreground="#4FC3F7" FontWeight="Bold" TextAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSwarmStart" Grid.Column="0" Content="▶ Echtzeit-Simulation starten"
                                        Click="BtnSwarmStart_Click" Padding="8,8" Margin="0,0,4,0" FontWeight="Bold" Background="#2E7D32" Foreground="White"/>
                                <Button x:Name="BtnSwarmCancel" Grid.Column="1" Content="⏹ Not-Aus (Cancel)"
                                        Click="BtnSwarmCancel_Click" Padding="8,8" Margin="4,0,0,0" FontWeight="Bold" Background="#C62828" Foreground="White" IsEnabled="False"/>
                            </Grid>
                            <TextBlock Text="Endlos-Simulation: Mausklick bzw. Ziehen im Bild setzt das Spieler-Ziel P_target. Parallel/Sequentiell und Thread-Anzahl lassen sich im laufenden Betrieb umschalten."
                                       Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="2. Live-Telemetrie &amp; Speedup" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <Border Background="#1B2631" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSwarmMode" Text="Modus: --" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSwarmStepTime" Text="Mittlere Schrittzeit: -- ms/step" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSwarmFps" Text="Simulations-Durchsatz: -- Steps/s (FPS)" FontFamily="Consolas" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSwarmSpeedup" Text="Gemessener Speedup S(p): -- x" FontFamily="Consolas" Foreground="#81C784" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSwarmAmdahl" Text="Serieller Anteil s (Amdahl): -- %" FontFamily="Consolas" Foreground="#FFB74D" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSwarmSteps" Text="Simulierte Schritte: --" FontFamily="Consolas" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                        <!-- ===================== GEMEINSAM: Amdahl-Tabelle ===================== -->
                        <TextBlock Text="3. Amdahl-Skalierungsreihe (1 .. P Kerne)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="ScalingProgressBar" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,6"/>
                        <DataGrid x:Name="ScalingGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="210"
                                  Background="#F5F5F5" Foreground="Black" RowBackground="#FFFFFF" AlternatingRowBackground="#EDEDED"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="p" Binding="{Binding Threads}" Width="40"/>
                                <DataGridTextColumn Header="Dauer [ms]" Binding="{Binding ElapsedMilliseconds, StringFormat=F2}" Width="85"/>
                                <DataGridTextColumn Header="Speedup S(p)" Binding="{Binding Speedup, StringFormat=F2}" Width="90"/>
                                <DataGridTextColumn Header="Effizienz E(p)" Binding="{Binding Efficiency, StringFormat=P1}" Width="90"/>
                                <DataGridTextColumn Header="Serieller Anteil s" Binding="{Binding SerialFractionText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TxtScalingSummary" Text="Noch keine Messreihe durchgeführt."
                                   Foreground="#FFB74D" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Bereit. N = 100.000 Partikel initialisiert." Foreground="#AAAAAA" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Kapitel 06: TPL Parallel.For | async/await | IProgress&lt;T&gt; | CancellationToken" Foreground="#777777" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
